// Prototipo local: SQLite. Ao migrar para Supabase, trocar provider para "postgresql"
// e DATABASE_URL para a connection string do pooler (ver README.md).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role: USER | ADMIN — status: ATIVO | INATIVO
model Usuario {
  id              String    @id @default(uuid())
  nome            String
  login           String    @unique
  senha           String
  role            String    @default("USER")
  status          String    @default("ATIVO")
  deveTrocarSenha Boolean   @default(false)
  ultimoLogin     DateTime?
  deletadoEm      DateTime?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  instancias    Instancia[]
  lancamentos   Lancamento[]
  pagamentos    Pagamento[]
  investimentos Investimento[]
  vouchers      Voucher[]
}

// status: ATIVO | USADO | REVOGADO | EXPIRADO
model Voucher {
  id          String    @id @default(uuid())
  codigo      String    @unique
  status      String    @default("ATIVO")
  usuarioId   String?
  usuario     Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  criadoEm    DateTime  @default(now())
  utilizadoEm DateTime?
  expiraEm    DateTime?
  criadoPor   String?
  observacao  String?
}

// grupo: gasto | receita | investimento
model Instancia {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nome      String
  grupo     String
  cor       String
  ativa     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  lancamentos   Lancamento[]
  pagamentos    Pagamento[]
  investimentos Investimento[]
}

// tipo: fixo | temporario
model Lancamento {
  id          String    @id @default(uuid())
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  descricao   String
  valor       Float
  tipo        String
  parcelas    Int?
  mesInicio   String
  mesFim      String?
  ativo       Boolean   @default(true)
  observacoes String?
  criadoEm    DateTime  @default(now())

  pagamentos Pagamento[]
}

// tipo: total | selecionado | parcial | avulso
model Pagamento {
  id            String      @id @default(uuid())
  usuarioId     String
  usuario       Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  instanciaId   String
  instancia     Instancia   @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  lancamentoId  String?
  lancamento    Lancamento? @relation(fields: [lancamentoId], references: [id], onDelete: SetNull)
  mesReferencia String
  valorPago     Float
  tipo          String
  observacoes   String?
  criadoEm      DateTime    @default(now())
}

model Investimento {
  id          String    @id @default(uuid())
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  descricao   String
  valor       Float
  observacoes String?
  criadoEm    DateTime  @default(now())
}
