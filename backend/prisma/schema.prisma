// Producao/Supabase: Postgres. DATABASE_URL = pooler (runtime), DIRECT_URL = conexao
// direta (usada so pelo Prisma Migrate para rodar DDL).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// role: USER | ADMIN — status: ATIVO | INATIVO
model Usuario {
  id              String    @id @default(uuid())
  nome            String
  login           String    @unique
  senha           String
  role            String    @default("USER")
  status          String    @default("ATIVO")
  deveTrocarSenha Boolean   @default(false)
  ultimoLogin     DateTime?
  deletadoEm      DateTime?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  instancias    Instancia[]
  lancamentos   Lancamento[]
  pagamentos    Pagamento[]
  investimentos Investimento[]
  vouchers      Voucher[]
  licenca       Licenca?
  concessoes    ConcessaoLicenca[]
}

// Direito de ESCRITA da conta, e so isso. A conta em si nunca vence: licenca
// expirada mantem login, leitura, relatorio, PDF e exportacao — bloqueia
// apenas a gravacao de dados novos.
//
// Eixo de estado proprio, deliberadamente separado dos outros dois, que
// respondem perguntas diferentes e nunca devem ser consolidados:
//   Usuario.status     -> a plataforma suspendeu esta conta?
//   Usuario.deletadoEm -> a conta foi excluida?
//   Licenca.expiraEm   -> esta conta pode escrever agora?
//
// Uma linha corrente por usuario (@unique em usuarioId): o historico de como
// se chegou nesta validade vive em ConcessaoLicenca, nunca aqui.
//
// origem e String + CHECK (nao enum do Prisma), igual ao resto do schema:
// valores futuros (APPLE_IAP, GOOGLE_PLAY) entram so alterando a CHECK, sem
// migration de tipo.
model Licenca {
  id           String   @id @default(uuid())
  usuarioId    String   @unique
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  inicioEm     DateTime
  expiraEm     DateTime
  origem       String
  atualizadoEm DateTime @updatedAt
  criadoEm     DateTime @default(now())

  @@index([expiraEm])
}

// Historico de auditoria das concessoes — append-only. Nunca sofre UPDATE nem
// DELETE: cada renovacao acrescenta uma linha registrando de onde veio e como
// a validade mudou (expiraEmAnterior -> expiraEmNovo). E o unico registro de
// por que uma licenca tem a data que tem.
model ConcessaoLicenca {
  id               String    @id @default(uuid())
  usuarioId        String
  usuario          Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  dias             Int
  origem           String
  referenciaId     String?
  expiraEmAnterior DateTime?
  expiraEmNovo     DateTime
  aplicadaEm       DateTime  @default(now())

  @@index([usuarioId])
}

// status: ATIVO | USADO | REVOGADO | EXPIRADO
model Voucher {
  id          String    @id @default(uuid())
  codigo      String    @unique
  status      String    @default("ATIVO")
  usuarioId   String?
  usuario     Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  criadoEm    DateTime  @default(now())
  utilizadoEm DateTime?
  expiraEm    DateTime?
  criadoPor   String?
  observacao  String?
}

// grupo: gasto | receita | investimento — subgrupo (so quando grupo=investimento): pessoal | patrimonial
model Instancia {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nome      String
  grupo     String
  subgrupo  String?
  cor       String
  ativa     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  lancamentos   Lancamento[]
  pagamentos    Pagamento[]
  investimentos Investimento[]
  ordenacoes    OrdenacaoInstancia[]
}

// contexto: lancamentos-gasto | lancamentos-receita | pagamentos | reserva —
// ordem manual (drag-and-drop) independente por tela; uma instancia pode
// aparecer em mais de um contexto (ex. gasto -> lancamentos-gasto e pagamentos).
// coluna: 0 = esquerda, 1 = direita (masonry de 2 colunas por contexto) —
// ordem passa a ser a posicao DENTRO da coluna, nao mais global.
model OrdenacaoInstancia {
  id          String    @id @default(uuid())
  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  contexto    String
  coluna      Int       @default(0)
  ordem       Int
  criadoEm    DateTime  @default(now())

  @@unique([instanciaId, contexto])
}

// tipo: fixo | temporario
model Lancamento {
  id          String    @id @default(uuid())
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  descricao   String
  valor       Float
  tipo        String
  parcelas    Int?
  mesInicio   String
  mesFim      String?
  valorMeta          Float?
  valorUltimaParcela Float?
  // total ja abatido antecipadamente das parcelas finais (da ultima pra primeira),
  // via "Lancar Valor Extra"/"Atualizar Valor" num projeto de reserva com meta.
  // Agregado = valorRendimento + soma dos ValorExtra vinculados. So usado quando
  // valorMeta != null.
  valorAbatido       Float    @default(0)
  // total acumulado (pode ser negativo) de rendimento/perda via "Atualizar Valor" —
  // um unico contador que so soma/subtrai a cada atualizacao, sem itens avulsos.
  valorRendimento    Float    @default(0)
  // tudo que ja foi acumulado ate o momento do ultimo "Reduzir Valor da Parcela"
  // (recalculo). Congela o passado: a partir dai, mesInicio/valor/parcelas/
  // valorUltimaParcela sao reescritos para representar so o que falta, e
  // valorAbatido volta a zero — sem isso, o recalculo reescreveria parcelas
  // que ja venceram no passado.
  valorBaseAcumulado Float    @default(0)
  // id do Pagamento (nao FK, so bookkeeping) que gerou este lancamento
  // automaticamente (excedente ou pendencia de "outro valor" em Pagamentos).
  criadoPorPagamentoId String?
  ativo       Boolean   @default(true)
  observacoes String?
  criadoEm    DateTime  @default(now())

  pagamentos    Pagamento[]
  valoresExtras ValorExtra[]
}

// Cada lancamento individual de "Lancar Valor Extra" num projeto de reserva com
// meta — mantido separado do rendimento pra dar visibilidade item a item.
model ValorExtra {
  id           String     @id @default(uuid())
  lancamentoId String
  lancamento   Lancamento @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  valor        Float
  descricao    String?
  // true quando aplicado via "Reduzir Valor da Parcela" (recalculo do
  // cronograma) — nao pode ser revertido individualmente, ja que reescreveu o
  // cronograma inteiro pra frente; para ajustar, o usuario revisa o projeto.
  viaRecalculo Boolean    @default(false)
  criadoEm     DateTime   @default(now())
}

// tipo: total | selecionado | parcial | avulso
model Pagamento {
  id            String      @id @default(uuid())
  usuarioId     String
  usuario       Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  instanciaId   String
  instancia     Instancia   @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  lancamentoId  String?
  lancamento    Lancamento? @relation(fields: [lancamentoId], references: [id], onDelete: SetNull)
  mesReferencia String
  valorPago     Float
  tipo          String
  observacoes   String?
  criadoEm      DateTime    @default(now())
}

model Investimento {
  id          String    @id @default(uuid())
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  descricao   String
  valor       Float
  observacoes String?
  criadoEm    DateTime  @default(now())
}
