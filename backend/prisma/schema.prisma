// Producao/Supabase: Postgres. DATABASE_URL = pooler (runtime), DIRECT_URL = conexao
// direta (usada so pelo Prisma Migrate para rodar DDL).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// role: USER | ADMIN — status: ATIVO | INATIVO
model Usuario {
  id              String    @id @default(uuid())
  nome            String
  login           String    @unique
  senha           String
  role            String    @default("USER")
  status          String    @default("ATIVO")
  deveTrocarSenha Boolean   @default(false)
  ultimoLogin     DateTime?
  deletadoEm      DateTime?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  instancias    Instancia[]
  lancamentos   Lancamento[]
  pagamentos    Pagamento[]
  investimentos Investimento[]
  vouchers      Voucher[]
}

// status: ATIVO | USADO | REVOGADO | EXPIRADO
model Voucher {
  id          String    @id @default(uuid())
  codigo      String    @unique
  status      String    @default("ATIVO")
  usuarioId   String?
  usuario     Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  criadoEm    DateTime  @default(now())
  utilizadoEm DateTime?
  expiraEm    DateTime?
  criadoPor   String?
  observacao  String?
}

// grupo: gasto | receita | investimento — subgrupo (so quando grupo=investimento): pessoal | patrimonial
model Instancia {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nome      String
  grupo     String
  subgrupo  String?
  cor       String
  ativa     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  lancamentos   Lancamento[]
  pagamentos    Pagamento[]
  investimentos Investimento[]
}

// tipo: fixo | temporario
model Lancamento {
  id          String    @id @default(uuid())
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  descricao   String
  valor       Float
  tipo        String
  parcelas    Int?
  mesInicio   String
  mesFim      String?
  valorMeta          Float?
  valorUltimaParcela Float?
  // total ja abatido antecipadamente das parcelas finais (da ultima pra primeira),
  // via "Lancar Valor Extra"/"Atualizar Valor" num projeto de reserva com meta.
  // Agregado = valorRendimento + soma dos ValorExtra vinculados. So usado quando
  // valorMeta != null.
  valorAbatido       Float    @default(0)
  // total acumulado (pode ser negativo) de rendimento/perda via "Atualizar Valor" —
  // um unico contador que so soma/subtrai a cada atualizacao, sem itens avulsos.
  valorRendimento    Float    @default(0)
  // id do Pagamento (nao FK, so bookkeeping) que gerou este lancamento
  // automaticamente (excedente ou pendencia de "outro valor" em Pagamentos).
  criadoPorPagamentoId String?
  ativo       Boolean   @default(true)
  observacoes String?
  criadoEm    DateTime  @default(now())

  pagamentos    Pagamento[]
  valoresExtras ValorExtra[]
}

// Cada lancamento individual de "Lancar Valor Extra" num projeto de reserva com
// meta — mantido separado do rendimento pra dar visibilidade item a item.
model ValorExtra {
  id           String     @id @default(uuid())
  lancamentoId String
  lancamento   Lancamento @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  valor        Float
  descricao    String?
  criadoEm     DateTime   @default(now())
}

// tipo: total | selecionado | parcial | avulso
model Pagamento {
  id            String      @id @default(uuid())
  usuarioId     String
  usuario       Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  instanciaId   String
  instancia     Instancia   @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  lancamentoId  String?
  lancamento    Lancamento? @relation(fields: [lancamentoId], references: [id], onDelete: SetNull)
  mesReferencia String
  valorPago     Float
  tipo          String
  observacoes   String?
  criadoEm      DateTime    @default(now())
}

model Investimento {
  id          String    @id @default(uuid())
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  descricao   String
  valor       Float
  observacoes String?
  criadoEm    DateTime  @default(now())
}
