# Prototipo local (SQLite) -> depois migrar para Supabase (ver PROMPT_DOMINIUM.md)
# IMPORTANTE: no Vercel o filesystem das functions e efemero/somente-leitura,
# entao SQLite NAO funciona em producao. DATABASE_URL/DIRECT_URL precisam
# apontar para Postgres (Supabase) antes do deploy.
DATABASE_URL="file:./dev.db"
# Producao (Supabase):
# DATABASE_URL="postgresql://...pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://...supabase.com:5432/postgres"

JWT_SECRET="troque-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="7d"

PORT=5001
NODE_ENV=development
# No Vercel (Services), frontend e backend ficam no mesmo dominio via rewrite
# de /api/*, entao o CORS baseado em FRONTEND_URL nao chega a ser acionado.
# Mantido para o dev local (frontend:5000 -> backend:5001, portas diferentes).
FRONTEND_URL="http://localhost:5000"

# Seed do administrador (ver prisma/seed.js). Nunca commitar valores reais aqui —
# preencha apenas no seu .env local/no painel de env vars da Vercel.
ADMIN_LOGIN="admin"
ADMIN_SENHA_INICIAL=

# Dias de licenca concedidos no cadastro (POST /api/auth/cadastro).
# PROVISORIO: no PR E o proprio voucher passa a carregar o numero de dias e
# esta variavel deixa de ser usada. Ate la, sem ela toda conta nova nasceria
# sem poder escrever.
LICENCA_PADRAO_DIAS=30

# Banco usado pelos testes automatizados (npm test). Precisa ser um banco
# DESCARTAVEL: a suite trunca todas as tabelas entre os casos. Sem esta
# variavel os testes se recusam a rodar, pra nunca atingirem dev/producao.
TEST_DATABASE_URL="postgresql://usuario@127.0.0.1:5434/dominium_test"
